# Contact form integration point.
# Set this to a real endpoint that accepts a JSON POST
# (Formspree, Web3Forms, Netlify Function, Vercel Function, your own API...).
# Leave empty and the form will honestly report that no service is connected.
VITE_CONTACT_ENDPOINT=

# Optional: public contact email shown in the contact section.
VITE_CONTACT_EMAIL=

# Optional: ISO launch date (e.g. 2027-03-01T10:00:00+05:30).
# Leave empty to show the Coming Soon animation instead of a countdown.
VITE_LAUNCH_DATE=

# Optional social profile URLs. Empty = shown as "coming soon" (not a dead link).
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_LINKEDIN_URL=
